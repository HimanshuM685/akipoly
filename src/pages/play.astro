---
import '../styles/global.css';
import Dashboard from '../components/Dashboard';
import Waterwave from '../components/Waterwave.astro';

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FFF500" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chango&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>akipoly — play the minigame</title>
    <script is:inline>
      try {
        if (sessionStorage.getItem('akipoly:wave-nav') === '1') {
          document.documentElement.classList.add('wave-pending');
        }
      } catch {
        /* private mode */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" class="play">
      <!-- Three.js monopoly game background -->
      <canvas class="game-field" aria-hidden="true"></canvas>

      <svg class="page__spark page__spark--tl twinkle twinkle--1" width="54" height="54" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#FF80B5" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>
      <svg class="page__spark page__spark--br twinkle twinkle--4" width="36" height="36" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#A78BFA" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>

      <div class="dash__top">
        <a class="docs__back" href="/">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M12 3 6 9l6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          back to the site
        </a>
        <a class="docs__wordmark" href="/" aria-label="akipoly — back to the site">
          <img src="/icons/akipoly-head@96.png" width="34" height="32" alt="" />
          <span>akipoly</span>
        </a>
      </div>

      <h1 class="play__title">play the minigame.</h1>
      <div class="dash__panel">
        <Dashboard client:only="react" />
      </div>

      <p class="page__legal">
        © {year} akipoly. all rights reserved.<br />
        arc testnet preview — nothing here holds real value. don't bet your life.
      </p>
    </main>
    <Waterwave />
    <script>
      import * as THREE from 'three';

      const canvas = document.querySelector('.game-field');
      if (!canvas) throw new Error('GameField: canvas not found');

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const scene = new THREE.Scene();
      scene.background = null;
      const camera = new THREE.PerspectiveCamera(60, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
      camera.position.z = 12;

      const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
      renderer.setSize(canvas.clientWidth, canvas.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const ambient = new THREE.AmbientLight(0xffffff, 0.6);
      scene.add(ambient);
      const dir = new THREE.DirectionalLight(0xffffff, 0.8);
      dir.position.set(5, 10, 7);
      scene.add(dir);

      const group = new THREE.Group();
      scene.add(group);

      const colors = [0xfff500, 0x9db7fb, 0xff6b4a, 0xb8f28b, 0xff80b5, 0xa78bfa];
      const diceGeo = new THREE.BoxGeometry(0.9, 0.9, 0.9);
      const diceMat = (color) => new THREE.MeshStandardMaterial({ color, flatShading: true });

      const dice = [];
      const count = reduced ? 4 : 12;

      for (let i = 0; i < count; i++) {
        const mesh = new THREE.Mesh(diceGeo, diceMat(colors[i % colors.length]));
        mesh.position.set(
          (Math.random() - 0.5) * 22,
          (Math.random() - 0.5) * 14,
          (Math.random() - 0.5) * 6
        );
        mesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
        mesh.userData = {
          drift: new THREE.Vector3((Math.random() - 0.5) * 0.02, (Math.random() - 0.5) * 0.02, (Math.random() - 0.5) * 0.02),
          spin: new THREE.Vector3((Math.random() - 0.5) * 0.015, (Math.random() - 0.5) * 0.015, (Math.random() - 0.5) * 0.015),
          floatOffset: Math.random() * Math.PI * 2,
        };
        group.add(mesh);
        dice.push(mesh);
      }

      const edgesGeo = new THREE.EdgesGeometry(diceGeo);
      const edgesMat = new THREE.LineBasicMaterial({ color: 0x171717, linewidth: 2 });

      function raf() {
        if (!reduced) {
          const t = performance.now() * 0.001;
          dice.forEach((m) => {
            m.position.x += m.userData.drift.x;
            m.position.y += m.userData.drift.y;
            m.position.z += Math.sin(t + m.userData.floatOffset) * 0.01;
            m.rotation.x += m.userData.spin.x;
            m.rotation.y += m.userData.spin.y;
            m.rotation.z += m.userData.spin.z;
            if (m.position.x > 12) m.position.x = -12;
            if (m.position.x < -12) m.position.x = 12;
            if (m.position.y > 8) m.position.y = -8;
            if (m.position.y < -8) m.position.y = 8;
          });
        }
        renderer.render(scene, camera);
        requestAnimationFrame(raf);
      }
      raf();

      const onResize = () => {
        camera.aspect = canvas.clientWidth / canvas.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(canvas.clientWidth, canvas.clientHeight);
      };
      window.addEventListener('resize', onResize);
    </script>
    <style>
      .game-field {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        width: 100vw;
        height: 100vh;
        display: block;
      }
      .play__title {
        position: relative;
        z-index: 1;
      }
    </style>
  </body>
</html>
