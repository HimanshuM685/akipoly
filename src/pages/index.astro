---
import '../styles/global.css';
import WaitlistForm from '../components/WaitlistForm.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Waterwave from '../components/Waterwave.astro';

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Akipoly is the property-trading board game, reimagined as a bold, playful GameFi experience on Arc. Roll the dice, own the board. Join the waitlist."
    />
    <meta name="theme-color" content="#FFF500" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chango&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Akipoly — Roll the Dice. Own the Board.</title>
    <script is:inline>
      try {
        if (sessionStorage.getItem('akipoly:wave-nav') === '1') {
          document.documentElement.classList.add('wave-pending');
        }
      } catch {
        /* private mode */
      }
    </script>
  </head>
  <body>
    <!-- Three.js animated monopoly background -->
    <canvas class="dice-field" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">Skip to content</a>
    <a class="page__help" href="/docs" aria-label="What is Akipoly? Read the explainer">?</a>
    <a class="page__dash" href="/play" target="_blank" rel="noopener noreferrer" aria-label="Open the Akipoly minigame in a new tab">
      <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
        <rect x="2" y="2" width="5" height="5" rx="1" fill="currentColor" />
        <rect x="9" y="2" width="5" height="5" rx="1" fill="currentColor" />
        <rect x="2" y="9" width="5" height="5" rx="1" fill="currentColor" />
        <rect x="9" y="9" width="5" height="5" rx="1" fill="currentColor" />
      </svg>
      play
    </a>
    <main id="main" class="page">
      <!-- decorative sparkles -->
      <svg class="page__spark page__spark--tl twinkle twinkle--1" width="54" height="54" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#FF80B5" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>
      <svg class="page__spark page__spark--tr twinkle twinkle--2" width="44" height="44" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#9DB7FB" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>
      <svg class="page__spark page__spark--bl twinkle twinkle--3" width="40" height="40" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#B8F28B" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>
      <svg class="page__spark page__spark--br twinkle twinkle--4" width="36" height="36" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#A78BFA" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>

      <h1>
        <img
          class="page__logo"
          src="/icons/akipoly-wordmark@1000.png"
          width="1000"
          height="798"
          alt="Akipoly"
        />
      </h1>
      <p class="page__tag">we create <span class="page__hl">monopoly</span> on arc</p>

      <div class="page__form" id="waitlist">
        <WaitlistForm />
      </div>

      <p class="page__legal">
        © {year} Akipoly. All rights reserved.<br />
      </p>
    </main>
    <Waterwave />
    <script>
      import * as THREE from 'three';

      const canvas = document.querySelector('.dice-field');
      if (!canvas) throw new Error('DiceField: canvas not found');

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const scene = new THREE.Scene();
      scene.background = null;
      const camera = new THREE.PerspectiveCamera(60, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
      camera.position.z = 12;

      const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
      renderer.setSize(canvas.clientWidth, canvas.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const ambient = new THREE.AmbientLight(0xffffff, 0.6);
      scene.add(ambient);
      const dir = new THREE.DirectionalLight(0xffffff, 0.8);
      dir.position.set(5, 10, 7);
      scene.add(dir);

      const group = new THREE.Group();
      scene.add(group);

      const colors = [0xfff500, 0x9db7fb, 0xff6b4a, 0xb8f28b, 0xff80b5, 0xa78bfa];
      const diceGeo = new THREE.BoxGeometry(0.9, 0.9, 0.9);
      const diceMat = (color) => new THREE.MeshStandardMaterial({ color, flatShading: true });

      const dice = [];
      const count = reduced ? 4 : 10;

      for (let i = 0; i < count; i++) {
        const mesh = new THREE.Mesh(diceGeo, diceMat(colors[i % colors.length]));
        mesh.position.set(
          (Math.random() - 0.5) * 22,
          (Math.random() - 0.5) * 14,
          (Math.random() - 0.5) * 6
        );
        mesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
        mesh.userData = {
          drift: new THREE.Vector3((Math.random() - 0.5) * 0.02, (Math.random() - 0.5) * 0.02, (Math.random() - 0.5) * 0.02),
          spin: new THREE.Vector3((Math.random() - 0.5) * 0.015, (Math.random() - 0.5) * 0.015, (Math.random() - 0.5) * 0.015),
          floatOffset: Math.random() * Math.PI * 2,
        };
        group.add(mesh);
        dice.push(mesh);
      }

      const edgesGeo = new THREE.EdgesGeometry(diceGeo);
      const edgesMat = new THREE.LineBasicMaterial({ color: 0x171717, linewidth: 2 });

      function raf() {
        if (!reduced) {
          const t = performance.now() * 0.001;
          dice.forEach((m) => {
            m.position.x += m.userData.drift.x;
            m.position.y += m.userData.drift.y;
            m.position.z += Math.sin(t + m.userData.floatOffset) * 0.01;
            m.rotation.x += m.userData.spin.x;
            m.rotation.y += m.userData.spin.y;
            m.rotation.z += m.userData.spin.z;
            if (m.position.x > 12) m.position.x = -12;
            if (m.position.x < -12) m.position.x = 12;
            if (m.position.y > 8) m.position.y = -8;
            if (m.position.y < -8) m.position.y = 8;
          });
        }
        renderer.render(scene, camera);
        requestAnimationFrame(raf);
      }
      raf();

      const onResize = () => {
        camera.aspect = canvas.clientWidth / canvas.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(canvas.clientWidth, canvas.clientHeight);
      };
      window.addEventListener('resize', onResize);
    </script>
    <style>
      .dice-field {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        width: 100vw;
        height: 100vh;
        display: block;
      }
      .page {
        position: relative;
        z-index: 1;
      }
    </style>
    <CookieBanner />
  </body>
</html>
