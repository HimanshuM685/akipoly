---
interface Props {
  /** "light" renders the wordmark in paper-white for dark backgrounds. */
  variant?: 'dark' | 'light';
  size?: number;
}

const { variant = 'dark', size = 38 } = Astro.props;
const wordmark = variant === 'dark' ? '#171717' : '#FFFDF2';
---

<a
  class="logo"
  href="#top"
  aria-label="Akipoly — back to top"
  style="display:inline-flex;align-items:center;gap:12px;text-decoration:none;border-radius:8px"
>
  <img
    src="/icons/akipoly-head@96.png"
    width={size}
    height={Math.round((size * 1208) / 1265)}
    alt=""
  />
  <span
    style={`font-family:var(--font-display);font-size:1.35rem;letter-spacing:0.02em;line-height:1;color:${wordmark}`}
  >
    AKIPOLY
  </span>
</a>
