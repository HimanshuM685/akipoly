---
import BoardMockup from './BoardMockup.astro';
---

<section class="section" id="showcase" aria-labelledby="showcase-title" style="padding-top:0">
  <div class="container">
    <div class="showcase__head">
      <h2 class="section-title" id="showcase-title">THE BOARD IS YOURS.</h2>
      <p class="section-copy" style="margin-inline:auto">
        Every tile has a price, every player has a plan, and somebody at the
        table is always about to regret their trade. Ownership. Strategy.
        Bare-faced negotiation.
      </p>
    </div>

    <div class="showcase__art">
      <BoardMockup />
    </div>
    <p class="showcase__caption">
      Mockups, not screenshots — the real board lands when the game does.
    </p>
  </div>
</section>
