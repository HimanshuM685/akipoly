---
const WORDS = ['BUY', 'BUILD', 'COMPETE', 'TRADE', 'ROLL', 'OWN'];
const chunk = WORDS.join('  ◆  ');
---

<!--
  Arcade ticket-tape strip between the hero and the about section.
  Decorative; the strip is a single static line hidden from assistive
  technology. No animation — deliberately.
-->
<div class="ticker" aria-hidden="true">
  <div class="ticker__track">{chunk}</div>
</div>
