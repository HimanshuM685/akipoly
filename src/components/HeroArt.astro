<!--
  Original decorative illustration for the hero — a stylised Akipoly board.
  Flat shapes, thick outlines, limited palette (design.md §9). No
  trademarked artwork is reproduced.
-->
<svg
  viewBox="0 0 560 560"
  role="img"
  aria-label="Stylised Akipoly game board with colourful property tiles, a white die showing five, and Akipoly coins."
>
  <!-- backdrop circle -->
  <circle cx="438" cy="112" r="92" fill="#9DB7FB" stroke="#171717" stroke-width="6" />

  <!-- board drop shadow + body -->
  <rect x="78" y="158" width="340" height="340" rx="16" fill="#171717" />
  <rect x="70" y="150" width="340" height="340" rx="16" fill="#FFFDF2" stroke="#171717" stroke-width="6" />

  <!-- tile ring -->
  <!-- top-left corner: JAIL -->
  <rect x="82" y="162" width="68" height="68" rx="6" fill="#FF6B4A" stroke="#171717" stroke-width="5" />
  <text x="116" y="201" text-anchor="middle" font-family="'Chango',sans-serif" font-size="15" fill="#171717">JAIL</text>

  <!-- top middle tiles -->
  <rect x="150" y="162" width="83" height="68" rx="6" fill="#B8F28B" stroke="#171717" stroke-width="5" />
  <line x1="166" y1="190" x2="217" y2="190" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <line x1="166" y1="206" x2="200" y2="206" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <rect x="247" y="162" width="83" height="68" rx="6" fill="#9DB7FB" stroke="#171717" stroke-width="5" />
  <line x1="263" y1="190" x2="314" y2="190" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <line x1="263" y1="206" x2="296" y2="206" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />

  <!-- top-right corner: BANK -->
  <rect x="330" y="162" width="68" height="68" rx="6" fill="#A78BFA" stroke="#171717" stroke-width="5" />
  <text x="364" y="201" text-anchor="middle" font-family="'Chango',sans-serif" font-size="13" fill="#171717">BANK</text>

  <!-- side tiles -->
  <rect x="82" y="230" width="68" height="83" rx="6" fill="#FF80B5" stroke="#171717" stroke-width="5" />
  <line x1="98" y1="266" x2="134" y2="266" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <line x1="98" y1="282" x2="124" y2="282" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <rect x="82" y="327" width="68" height="83" rx="6" fill="#FFF500" stroke="#171717" stroke-width="5" />
  <line x1="98" y1="363" x2="134" y2="363" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <line x1="98" y1="379" x2="124" y2="379" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />

  <rect x="330" y="230" width="68" height="83" rx="6" fill="#9DB7FB" stroke="#171717" stroke-width="5" />
  <line x1="346" y1="266" x2="382" y2="266" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <line x1="346" y1="282" x2="371" y2="282" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <rect x="330" y="327" width="68" height="83" rx="6" fill="#FF6B4A" stroke="#171717" stroke-width="5" />
  <line x1="346" y1="363" x2="382" y2="363" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <line x1="346" y1="379" x2="371" y2="379" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />

  <!-- bottom-left corner: TAX -->
  <rect x="82" y="410" width="68" height="68" rx="6" fill="#A78BFA" stroke="#171717" stroke-width="5" />
  <text x="116" y="450" text-anchor="middle" font-family="'Chango',sans-serif" font-size="15" fill="#171717">TAX</text>

  <!-- bottom middle tiles -->
  <rect x="150" y="410" width="83" height="68" rx="6" fill="#9DB7FB" stroke="#171717" stroke-width="5" />
  <line x1="166" y1="438" x2="217" y2="438" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <line x1="166" y1="454" x2="200" y2="454" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <rect x="247" y="410" width="83" height="68" rx="6" fill="#B8F28B" stroke="#171717" stroke-width="5" />
  <line x1="263" y1="438" x2="314" y2="438" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />
  <line x1="263" y1="454" x2="296" y2="454" stroke="#171717" stroke-width="5" stroke-linecap="round" opacity="0.75" />

  <!-- bottom-right corner: GO -->
  <rect x="330" y="410" width="68" height="68" rx="6" fill="#FFF500" stroke="#171717" stroke-width="5" />
  <text x="364" y="452" text-anchor="middle" font-family="'Chango',sans-serif" font-size="21" fill="#171717">GO</text>

  <!-- centre field -->
  <rect x="158" y="238" width="164" height="164" rx="8" fill="#FFF500" stroke="#171717" stroke-width="5" />
  <polygon
    points="240,258 243.5,269.5 255.5,271 246,278.5 249.5,290.5 240,284 230.5,290.5 234,278.5 224.5,271 236.5,269.5"
    fill="#171717"
  />
  <text x="240" y="338" text-anchor="middle" font-family="'Chango',sans-serif" font-size="27" fill="#171717">AKIPOLY</text>
  <text x="240" y="366" text-anchor="middle" font-family="'Space Grotesk',sans-serif" font-weight="700" font-size="11" letter-spacing="2" fill="#171717">ROLL · TRADE · OWN</text>

  <!-- floating coins -->
  <circle cx="92" cy="112" r="27" fill="#B8F28B" stroke="#171717" stroke-width="5" />
  <text x="92" y="121" text-anchor="middle" font-family="'Chango',sans-serif" font-size="22" fill="#171717">A</text>
  <circle cx="158" cy="72" r="18" fill="#FFF500" stroke="#171717" stroke-width="5" />
  <text x="158" y="79" text-anchor="middle" font-family="'Chango',sans-serif" font-size="15" fill="#171717">A</text>

  <!-- die, overlapping the board's corner -->
  <g transform="translate(432 424) rotate(-16)">
    <rect x="7" y="7" width="96" height="96" rx="18" fill="#171717" />
    <rect width="96" height="96" rx="18" fill="#FFFFFF" stroke="#171717" stroke-width="6" />
    <circle cx="26" cy="26" r="8.5" fill="#171717" />
    <circle cx="70" cy="26" r="8.5" fill="#171717" />
    <circle cx="48" cy="48" r="8.5" fill="#171717" />
    <circle cx="26" cy="70" r="8.5" fill="#171717" />
    <circle cx="70" cy="70" r="8.5" fill="#171717" />
  </g>

  <!-- WAITLIST OPEN sticker -->
  <g transform="translate(428 52) rotate(10)">
    <g class="bob" style="--bob-rotate:0deg">
      <rect x="-79" y="-24" width="168" height="66" rx="12" fill="#171717" />
      <rect x="-86" y="-31" width="168" height="66" rx="12" fill="#FF80B5" stroke="#171717" stroke-width="5" />
      <text x="-2" y="-4" text-anchor="middle" font-family="'Chango',sans-serif" font-size="18" fill="#171717">WAITLIST</text>
      <text x="-2" y="20" text-anchor="middle" font-family="'Chango',sans-serif" font-size="18" fill="#171717">OPEN</text>
    </g>
  </g>

  <!-- sparkles -->
  <polygon points="0,-15 3.8,-3.8 15,0 3.8,3.8 0,15 -3.8,3.8 -15,0 -3.8,-3.8" transform="translate(96 268)" fill="#FF80B5" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
  <polygon points="0,-13 3.3,-3.3 13,0 3.3,3.3 0,13 -3.3,3.3 -13,0 -3.3,-3.3" transform="translate(494 198)" fill="#FFF500" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
  <polygon points="0,-11 2.8,-2.8 11,0 2.8,2.8 0,11 -2.8,2.8 -11,0 -2.8,-2.8" transform="translate(56 392)" fill="#A78BFA" stroke="#171717" stroke-width="4" stroke-linejoin="round" />

  <!-- squiggle -->
  <path d="M52 470 q 16 -16 32 0 t 32 0 t 32 0" fill="none" stroke="#171717" stroke-width="5" stroke-linecap="round" />
</svg>
