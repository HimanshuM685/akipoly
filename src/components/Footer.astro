---
import Logo from './Logo.astro';

// Placeholder social destinations — replace the hrefs with the real profile
// URLs once the accounts exist. Keep them in one place.
const SOCIAL_LINKS = [
  {
    label: 'Akipoly on X',
    href: '#',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"/></svg>`,
  },
  {
    label: 'Akipoly on Instagram',
    href: '#',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.4" fill="currentColor" stroke="none"/></svg>`,
  },
  {
    label: 'Akipoly on YouTube',
    href: '#',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="4"/><path d="M10.5 10v4l3.5-2z" fill="currentColor" stroke="none"/></svg>`,
  },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__inner">
      <div>
        <Logo variant="light" />
        <p class="footer__tagline">Own the board. Make your move.</p>
      </div>
      <ul class="footer__social">
        {SOCIAL_LINKS.map((link) => (
          <li>
            <a href={link.href} aria-label={link.label} rel="me">
              <Fragment set:html={link.icon} />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="footer__bottom">
      <p>© {year} Akipoly. All rights reserved.</p>
      <p>Akipoly is an independent project. Not affiliated with any classic board game or its publisher.</p>
    </div>
  </div>
</footer>
