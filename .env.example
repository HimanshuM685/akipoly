# Optional. URL of a backend endpoint that accepts POST { email, source }
# as JSON and returns 2xx on success. When unset, the waitlist form runs in
# local demo mode (no network call, nothing persisted to a server).
# PUBLIC_WAITLIST_ENDPOINT=https://example.com/api/waitlist

# Required for /dashboard: your Privy App ID (public by design — never the secret).
# The Privy App Secret must never appear in this repo or in any client bundle.
# Find the App ID in the Privy dashboard.
# PUBLIC_PRIVY_APP_ID=your-privy-app-id
