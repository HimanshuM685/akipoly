# Server-side only. Connection string for the Neon database; used by
# /api/waitlist to insert emails. Set this in the VERCEL PROJECT SETTINGS —
# never commit a real value, never prefix with PUBLIC_. The pooled endpoint
# (ep-xxx-pooler.*.aws.neon.tech) is the right choice for serverless functions.
# DATABASE_URL=postgresql://user:password@host-pooler/neondb?sslmode=require&channel_binding=require

# Optional. Override the waitlist endpoint the form posts to (defaults to the
# site's own /api/waitlist).
# PUBLIC_WAITLIST_ENDPOINT=https://example.com/api/waitlist

# Required for /dashboard: your Privy App ID (public by design — never the secret).
# The Privy App Secret must never appear in this repo or in any client bundle.
# Find the App ID in the Privy dashboard.
# PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Arc network for wallets, balances and payments: testnet | mainnet.
# Must match the game server's ARC_NETWORK (backend/.env).
# PUBLIC_ARC_NETWORK=testnet

# WebSocket endpoint for the game backend (VPS)
# PUBLIC_WS_URL=wss://ws.akipoly.xyz
# For local development:
# PUBLIC_WS_URL=ws://localhost:8081
